<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ansen.twitchmonitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/t7/project/twitch-monitor/start_monitor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- 收到 SIGTERM 後留時間讓錄影收尾、轉檔、上傳；預設 20 秒不夠 -->
    <key>ExitTimeOut</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/Volumes/t7/project/twitch-monitor/logs/dexterityboost-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/t7/project/twitch-monitor/logs/dexterityboost-stderr.log</string>
</dict>
</plist>
