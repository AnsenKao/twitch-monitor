<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ansen.twitchmonitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/t7/project/twitch-monitor/start_monitor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- 收到 SIGTERM 後給 streamlink 收好 .ts 的時間。launchd 上限就是 60 秒，
         寫再大也會被截到 60，所以轉檔和上傳不會在關機時做 -->
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <!-- launchd 無法在外接磁碟 /Volumes/t7 上開 stdout 檔（會 EX_CONFIG 起不來），所以放本機 -->
    <key>StandardOutPath</key>
    <string>/Users/ansen/Library/Logs/twitchmonitor/dexterityboost-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ansen/Library/Logs/twitchmonitor/dexterityboost-stderr.log</string>
</dict>
</plist>
